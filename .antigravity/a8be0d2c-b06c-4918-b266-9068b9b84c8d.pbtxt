    content: "            {filteredNotes.length === 0 && (\n              <div className=\"text-center py-10 text-slate-500 text-xs\">\n                <FolderOpen className=\"w-8 h-8 mx-auto mb-2 opacity-40\" />\n                No notes match your filter.\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Reader / Editor Column */}\n        <div className=\"lg:col-span-8 rounded-2xl bg-slate-900/80 border border-purple-500/20 backdrop-blur-md p-6 flex flex-col shadow-2xl overflow-hidden relative\">\n          {isEditing ? (\n            /* Note Editor Form */\n            <div className=\"flex-1 flex flex-col space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-purple-500/20\">\n                <input\n                  type=\"text\"\n                  value={editTitle}\n                  onChange={e => setEditTitle(e.target.value)}\n                  placeholder=\"Note Title...\"\n                  className=\"bg-transparent text-base font-bold text-white focus:outline-none placeholder:text-slate-600 flex-1 min-w-[200px]\"\n                />\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => setIsEditing(false)}\n                    className=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition-colors\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    onClick={handleSave}\n                    className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-violet-600 text-white text-xs font-bold shadow-md shadow-purple-950/40\"\n                  >\n                    <Save className=\"w-3.5 h-3.5\" />\n                    Save Note\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs\">\n                <div>\n                  <label className=\"text-[10px] text-slate-400 font-semibold block mb-1\">Subject</label>\n                  <select\n                    value={editSubject}\n                    onChange={e => setEditSubject(e.target.value)}\n                    className=\"w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200 outline-none\"\n                  >\n                    {SUBJECT_LIST.filter(s => s !== \'All Subjects\').map(s => (\n                      <option key={s} value={s}>{s}</option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-[10px] text-slate-400 font-semibold block mb-1\">Tags (Comma-separated)</label>\n                  <input\n                    type=\"text\"\n                    value={editTags}\n                    onChange={e => setEditTags(e.target.value)}\n                    placeholder=\"Formulas, Exam, Review\"\n                    className=\"w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200 outline-none\"\n                  />\n                </div>\n\n                <div className=\"flex items-end pb-1\">\n                  <label className=\"flex items-center gap-2 text-slate-300 cursor-pointer text-xs\">\n                    <input\n                      type=\"checkbox\"\n                      checked={editIsFormula}\n                      onChange={e => setEditIsFormula(e.target.checked)}\n                      className=\"accent-purple-500 rounded\"\n                    />\n                    <span>Mark as Formula Sheet</span>\n                  </label>\n                </div>\n              </div>\n\n              <div className=\"flex-1 flex flex-col\">\n                <label className=\"text-[10px] text-slate-400 font-semibold block mb-1\">\n                  Note Content (Supports Markdown and Math $equations$)\n                </label>\n                <textarea\n                  value={editContent}\n                  onChange={e => setEditContent(e.target.value)}\n                  placeholder=\"Type your notes, equations ($E = mc^2$), definitions, and summaries here...\"\n                  className=\"flex-1 w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-xs font-mono text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-purple-500 resize-none leading-relaxed\"\n                />\n              </div>\n            </div>\n          ) : activeNote ? (\n            /* Note Reader View */\n            <div className=\"flex-1 flex flex-col overflow-hidden\">\n              <div className=\"flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-purple-500/20\">\n                <div>\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <span className=\"text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30\">\n                      {activeNote.subject}\n                    </span>\n                    {activeNote.isFormulaSheet && (\n                      <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n                        Formula Bank\n                      </span>\n                    )}\n                  </div>\n                  <h3 className=\"text-lg font-bold text-white\">{activeNote.title}</h3>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopyNote(activeNote.content, activeNote.id)}\n                    className=\"p-2 rounded-lg bg-slate-950 hover:bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-colors text-xs flex items-center gap-1.5\"\n                    title=\"Copy note content\"\n                  >\n                    {copiedId === activeNote.id ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>{copiedId === activeNote.id ? \'Copied\' : \'Copy\'}</span>\n                  </button>\n\n                  <button\n                    onClick={handleEditActive}\n                    className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-900/50 hover:bg-purple-800/70 border border-purple-500/40 text-purple-200 text-xs font-semibold transition-all\"\n                  >\n                    <Edit3 className=\"w-3.5 h-3.5\" />\n                    <span>Edit</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Note Tags */}\n              {activeNote.tags && activeNote.tags.length > 0 && (\n                <div className=\"flex flex-wrap gap-1.5 mb-4\">\n                  {activeNote.tags.map((t, idx) => (\n                    <span key={idx} className=\"text-[10px] px-2 py-0.5 rounded-md bg-slate-950 text-slate-400 border border-slate-800\">\n                      #{t}\n                    </span>\n                  ))}\n                </div>\n              )}\n\n              {/* Rendered Content */}\n              <div className=\"flex-1 overflow-y-auto pr-2 custom-scrollbar\">\n                <FormattedContent content={activeNote.content} />\n              </div>\n            </div>\n          ) : (\n            <div className=\"flex-1 flex flex-col items-center justify-center text-slate-500 text-xs\">\n              <FileText className=\"w-10 h-10 mb-2 opacity-30\" />\n              <span>Select a note or create a new one to begin.</span>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 406
    num_bytes: 17666
