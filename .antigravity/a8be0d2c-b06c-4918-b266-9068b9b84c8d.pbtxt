            }
            lines {
              text: "    content: `# Key Derivatives Cheatsheet"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. **Power Rule**: $\\\\frac{d}{dx}[x^n] = n x^{n-1}$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "2. **Product Rule**: $\\\\frac{d}{dx}[u \\\\cdot v] = u\'v + uv\'$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "3. **Quotient Rule**: $\\\\frac{d}{dx}\\\\left[\\\\frac{u}{v}\\\\right] = \\\\frac{u\'v - uv\'}{v^2}$ (Low d-High minus High d-Low over Low squared)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "4. **Chain Rule**: $\\\\frac{d}{dx}[f(g(x))] = f\'(g(x)) \\\\cdot g\'(x)$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### Trigonometric Derivatives:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- $\\\\frac{d}{dx}[\\\\sin x] = \\\\cos x$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- $\\\\frac{d}{dx}[\\\\cos x] = -\\\\sin x$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- $\\\\frac{d}{dx}[\\\\tan x] = \\\\sec^2 x$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- $\\\\frac{d}{dx}[\\\\ln(x)] = \\\\frac{1}{x}$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- $\\\\frac{d}{dx}[e^x] = e^x$"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "*Exam Tip: Always check if the inner function requires chain rule!*`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
