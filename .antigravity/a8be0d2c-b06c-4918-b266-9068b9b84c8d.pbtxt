te-error\'] = simulatedErrorMode;\n      }\n\n      // Stream endpoint for fast, progressive response\n      const response = await fetch(\'/api/tutor/chat/stream\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          messages: updatedSessionMessages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: textToSend,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment,\n          attachment: currentAttach ? { mimeType: currentAttach.mimeType, data: currentAttach.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        const { friendlyMsg, code } = getFriendlyErrorMessage(response.status, errData);\n\n        // Remove placeholder AI message on error, keep user\'s question\n        const restoredSession: ChatSession = {\n          ...sessionWithPlaceholder,\n          messages: updatedSessionMessages,\n        };\n        setSessions(prev => prev.map(s => s.id === currentSession.id ? restoredSession : s));\n        StorageService.saveChat(restoredSession);\n\n        setActiveError({\n          message: friendlyMsg,\n          errorCode: code,\n          statusCode: response.status,\n          failedMessageId: userMsgId,\n          pendingText: textToSend,\n          pendingAttachment: currentAttach,\n          pendingAssessment: requestAssessment,\n        });\n        return;\n      }\n\n      // Read SSE stream progressively\n      const reader = response.body?.getReader();\n      const decoder = new TextDecoder(\'utf-8\');\n\n      if (!reader) throw new Error(\'ReadableStream not supported\');\n\n      let buffer = \'\';\n      while (true) {\n        const { done, value } = await reader.read();\n        if (done) break;\n\n        buffer += decoder.decode(value, { stream: true });\n        const parts = buffer.split(\'\\n\\n\');\n        buffer = parts.pop() || \'\';\n\n        for 