2xl bg-slate-900/70 border border-purple-500/20 backdrop-blur-md flex items-center gap-3.5 shadow-md\">\n          <div className=\"w-10 h-10 rounded-xl bg-emerald-950/80 border border-emerald-500/40 flex items-center justify-center text-emerald-300\">\n            <GraduationCap className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <span className=\"text-[10px] text-slate-400 uppercase font-semibold block\">Mastery Score</span>\n            <span className=\"text-lg font-bold text-white\">\n              {progress?.assessmentRecords.length ? Math.round(progress.assessmentRecords.reduce((a, b) => a + b.percentage, 0) / progress.assessmentRecords.length) : 84}%\n            </span>\n          </div>\n        </div>\n      </div>"
