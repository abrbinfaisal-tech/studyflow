    content: "      });\n    } finally {\n      setLoading(false);\n      setStreamingMsgId(null);\n    }\n  };\n\n  const handleSaveToNotesClick = (messageContent: string) => {\n    if (onSaveToNotes) {\n      onSaveToNotes({\n        title: `${selectedSubject} Notes - ${new Date().toLocaleDateString()}`,\n        subject: selectedSubject,\n        content: messageContent,\n        tags: [selectedSubject, \'Tutor Explanation\'],\n      });\n    }\n  };\n\n  return (\n    <div className=\"flex h-[calc(100vh-5rem)] max-w-7xl mx-auto gap-4\">\n      {/* Left Chat Sessions Drawer / Sidebar */}\n      <div className=\"hidden md:flex flex-col w-64 rounded-2xl bg-slate-900/70 border border-purple-500/20 backdrop-blur-md p-3.5 shadow-xl\">\n        <button\n          onClick={() => createNewChat()}\n          className=\"flex items-center justify-center gap-2 w-full py-2.5 px-3 rounded-xl bg-gradient-to-r from-purple-600 to-violet-600 hover:from-purple-500 hover:to-violet-500 text-white font-medium text-xs shadow-md shadow-purple-950/40 transition-all mb-3\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          New Study Session\n        </button>\n\n        <div className=\"text-[11px] font-semibold text-purple-300/70 uppercase tracking-wider px-2 mb-1.5 flex items-center justify-between\">\n          <span>Saved Sessions</span>\n          <span className=\"text-[10px] px-1.5 py-0.5 rounded-full bg-slate-800 text-slate-400\">\n            {sessions.length}\n          </span>\n        </div>\n\n        <div className=\"flex-1 overflow-y-auto space-y-1.5 pr-1 custom-scrollbar\">\n          {sessions.map(s => {\n            const isActive = s.id === currentSessionId;\n            return (\n              <div\n                key={s.id}\n                onClick={() => setCurrentSessionId(s.id)}\n                className={`group flex items-center justify-between p-2.5 rounded-xl cursor-pointer transition-all text-xs border ${\n                  isActive\n                    ? \'bg-purple-950/60 border-purple-500/50 text-white shadow-sm\'\n                    : \'bg-slate-900/40 border-transparent hover:border-slate-800 text-slate-300 hover:bg-slate-800/60\'\n                }`}\n              >\n                <div className=\"flex items-center gap-2 overflow-hidden\">\n                  <MessageSquare className={`w-3.5 h-3.5 shrink-0 ${isActive ? \'text-purple-400\' : \'text-slate-500\'}`} />\n                  <span className=\"truncate font-medium\">{s.title || \'Untitled Session\'}</span>\n                </div>\n                <button\n                  onClick={(e) => deleteSession(s.id, e)}\n                  className=\"opacity-0 group-hover:opacity-100 hover:text-rose-400 text-slate-500 transition-opacity p-1\"\n                  title=\"Delete session\"\n                >\n                  <Trash2 className=\"w-3 h-3\" />\n                </button>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Quick controls in sidebar footer */}\n        <div className=\"pt-3 border-t border-slate-800 space-y-2\">\n          <div>\n            <label className=\"text-[10px] text-slate-400 uppercase tracking-wider font-semibold block mb-1\">\n              Academic Level\n            </label>\n            <select\n              value={gradeLevel}\n              onChange={e => setGradeLevel(e.target.value)}\n              className=\"w-full text-xs bg-slate-950 border border-slate-800 rounded-lg px-2 py-1.5 text-slate-300 focus:border-purple-500 outline-none\"\n            >\n              <option value=\"Middle School\">Middle School</option>\n              <option value=\"High School\">High School (AP / IB / A-Level)</option>\n              <option value=\"High School / College\">College / University</option>\n              <option value=\"Competitive Exam\">Competitive Exam Prep</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Chat Interface */}\n      <div className=\"flex-1 flex flex-col rounded-2xl bg-slate-900/80 border border-purple-500/20 backdrop-blur-md shadow-2xl overflow-hidden relative\">\n        {/* Chat Header */}\n        <div className=\"flex flex-wrap items-center justify-between px-5 py-3.5 border-b border-purple-500/20 bg-slate-950/40\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600 to-violet-700 flex items-center justify-center text-white shadow-md shadow-purple-900/30\">\n              <Bot className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm font-bold text-white\">AI Personal Tutor</h3>\n                <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n                  Active\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">{currentSession?.title || \'Interactive Session\'}</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 mt-2 sm:mt-0\">\n            {/* Subject Selector */}\n            <select\n              value={selectedSubject}\n              onChange={e => setSelectedSubject(e.target.value)}\n              className=\"text-xs bg-slate-900/90 border border-purple-500/30 rounded-lg px-2.5 py-1.5 text-purple-200 outline-none hover:border-purple-500\"\n            >\n              <option value=\"General\">All Subjects</option>\n              <option value=\"Mathematics\">Mathematics</option>\n              <option value=\"Physics\">Physics</option>"
    num_lines: 1101
