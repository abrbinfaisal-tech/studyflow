  code_action {
    action_spec {
      create_file {
        instruction: "// Web Audio API Synthesizer for study bell / timer completion chimes and relaxing ambient noise\n\nclass AudioService {\n  private ctx: AudioContext | null = null;\n  private noiseNode: AudioNode | null = null;\n  private isNoisePlaying = false;\n\n  private initCtx() {\n    if (!this.ctx) {\n      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;\n      if (AudioCtx) {\n        this.ctx = new AudioCtx();\n      }\n    }\n    if (this.ctx && this.ctx.state === \'suspended\') {\n      this.ctx.resume();\n    }\n    return this.ctx;\n  }\n\n  // Pleasant bell chime for Pomodoro complete\n  playChime() {\n    try {\n      const ctx = this.initCtx();\n      if (!ctx) return;\n\n      const now = ctx.currentTime;\n      // Play a harmonic 3-tone chime (E5, G#5, B5)\n      const notes = [659.25, 830.61, 987.77];\n      notes.forEach((freq, idx) => {\n        const osc = ctx.createOscillator();\n        const gain = ctx.createGain();\n\n        osc.type = \'sine\';\n        osc.frequency.setValueAtTime(freq, now + idx * 0.15);\n\n        gain.gain.setValueAtTime(0, now + idx * 0.15);\n        gain.gain.linearRampToValueAtTime(0.2, now + idx * 0.15 + 0.05);\n        gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.15 + 1.2);\n\n        osc.connect(gain);\n        gain.connect(ctx.destination);\n\n        osc.start(now + idx * 0.15);\n        osc.stop(now + idx * 0.15 + 1.2);\n      });\n    } catch (e) {\n      console.warn(\'Audio chime error:\', e);\n    }\n  }\n\n  // Pleasant click sound on timer start/pause\n  playTick() {\n    try {\n      const ctx = this.initCtx();\n      if (!ctx) return;\n      const now = ctx.currentTime;\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = \'triangle\';\n      osc.frequency.setValueAtTime(440, now);\n      gain.gain.setValueAtTime(0.05, now);\n      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.08);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start(now);\n      osc.stop(now + 0.08);\n    } catch (e) {\n      // ignore\n    }\n  }\n\n  // Gentle pink noise / rain simulation for deep focus\n  toggleAmbient(type: \'rain\' | \'white\' | \'off\') {\n    const ctx = this.initCtx();\n    if (!ctx) return false;\n\n    if (this.noiseNode) {\n      try {\n        (this.noiseNode as any).disconnect();\n      } catch (e) {}\n      this.noiseNode = null;\n      this.isNoisePlaying = false;\n    }\n\n    if (type === \'off\') {\n      return false;\n    }\n\n    try {\n      const bufferSize = ctx.sampleRate * 2;\n      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n      const data = buffer.getChannelData(0);\n\n      let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;\n      for (let i = 0; i < bufferSize; i++) {\n        const white = Math.random() * 2 - 1;\n        if (type === \'rain\') {\n          // Pink noise filter approximation\n          b0 = 0.99886 * b0 + white * 0.0555179;\n          b1 = 0.99332 * b1 + white * 0.0750759;\n          b2 = 0.96900 * b2 + white * 0.1538520;\n          b3 = 0.86650 * b3 + white * 0.3104856;\n          b4 = 0.55000 * b4 + white * 0.5329522;\n          b5 = -0.7616 * b5 - white * 0.0168980;\n          data[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.035;\n          b6 = white * 0.115926;\n        } else {\n          data[i] = white * 0.02;\n        }\n      }\n\n      const noiseSource = ctx.createBufferSource();\n      noiseSource.buffer = buffer;\n      noiseSource.loop = true;\n\n      const gain = ctx.createGain();\n      gain.gain.value = 0.12;\n\n      // Filter for soothing soft tones\n      const filter = ctx.createBiquadFilter();\n      filter.type = \'lowpass\';\n      filter.frequency.value = type === \'rain\' ? 800 : 1200;\n\n      noiseSource.connect(filter);\n      filter.connect(gain);\n      gain.connect(ctx.destination);\n\n      noiseSource.start(0);\n      this.noiseNode = noiseSource;\n      this.isNoisePlaying = true;\n      return true;\n    } catch (e) {\n      console.warn(\'Ambient noise error:\', e);\n      return false;\n    }\n  }\n\n  isAmbientPlaying() {\n    return this.isNoisePlaying;\n  }\n}\n\nexport const sound = new AudioService();\n"
        path {
          absolute_uri: "file:///src/utils/audio.ts"
        }
        overwrite: true
      }
    }
