    content: "              <option value=\"Competitive Exam\">Competitive Exam Prep</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Chat Interface */}\n      <div className=\"flex-1 flex flex-col rounded-2xl bg-slate-900/80 border border-purple-500/20 backdrop-blur-md shadow-2xl overflow-hidden relative\">\n        {/* Chat Header */}\n        <div className=\"flex flex-wrap items-center justify-between px-5 py-3.5 border-b border-purple-500/20 bg-slate-950/40\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600 to-violet-700 flex items-center justify-center text-white shadow-md shadow-purple-900/30\">\n              <Bot className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm font-bold text-white\">AI Personal Tutor</h3>\n                <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n                  Active\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">{currentSession?.title || \'Interactive Session\'}</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 mt-2 sm:mt-0\">\n            {/* Subject Selector */}\n            <select\n              value={selectedSubject}\n              onChange={e => setSelectedSubject(e.target.value)}\n              className=\"text-xs bg-slate-900/90 border border-purple-500/30 rounded-lg px-2.5 py-1.5 text-purple-200 outline-none hover:border-purple-500\"\n            >\n              <option value=\"General\">All Subjects</option>\n              <option value=\"Mathematics\">Mathematics</option>\n              <option value=\"Physics\">Physics</option>\n              <option value=\"Chemistry\">Chemistry</option>\n              <option value=\"Biology\">Biology</option>\n              <option value=\"Computer Science\">Computer Science</option>\n              <option value=\"Economics\">Economics</option>\n              <option value=\"Literature & History\">Humanities</option>\n            </select>\n\n            {/* Error Simulation Selector for testing error recovery and retry */}\n            <div className=\"flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-950/80 border border-purple-500/30 text-[11px] text-slate-300\">\n              <FlaskConical className=\"w-3.5 h-3.5 text-purple-400\" />\n              <select\n                value={simulatedErrorMode}\n                onChange={e => setSimulatedErrorMode(e.target.value)}\n                className=\"bg-transparent text-purple-200 outline-none text-xs cursor-pointer font-medium\"\n                title=\"Select simulation mode to test error recovery\"\n              >\n                <option value=\"none\" className=\"bg-slate-900 text-slate-200\">Mode: Live AI</option>\n                <option value=\"503\" className=\"bg-slate-900 text-amber-300\">Test 503 (High Demand)</option>\n                <option value=\"429\" className=\"bg-slate-900 text-amber-300\">Test 429 (Usage Limit)</option>\n                <option value=\"401\" className=\"bg-slate-900 text-rose-300\">Test 401 (Auth Notice)</option>\n                <option value=\"network\" className=\"bg-slate-900 text-rose-300\">Test Network Error</option>\n              </select>\n            </div>\n\n            {/* Assessment Request Button */}\n            <button\n              onClick={() => sendMessage(`Please give me an assessment quiz on the concepts we have been discussing to check my understanding.`, true)}\n              disabled={loading}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-900/40 hover:bg-purple-800/60 border border-purple-500/40 text-purple-200 text-xs font-semibold shadow-sm transition-all\"\n              title=\"Generate a 3-question knowledge quiz\"\n            >\n              <GraduationCap className=\"w-3.5 h-3.5 text-purple-300\" />\n              <span>Quiz Me</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Messages Stream */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-5 custom-scrollbar\">\n          {/* Starter prompts if fresh session */}\n          {currentSession?.messages.length === 1 && (\n            <div className=\"mb-6 p-4 rounded-xl bg-purple-950/20 border border-purple-500/20\">\n              <span className=\"text-xs font-semibold text-purple-300 flex items-center gap-1.5 mb-2.5\">\n                <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n                Quick Concept Jumpstarts:"
    num_lines: 1033
