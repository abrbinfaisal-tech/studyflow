            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "4. **Oxidative Phosphorylation & Electron Transport Chain** (Inner Membrane)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Chemiosmosis driven by proton gradient across inner membrane."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Theoretical yield: ~30-32 ATP per glucose molecule."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Final electron acceptor: **Oxygen (O2)**, forming H2O!`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
