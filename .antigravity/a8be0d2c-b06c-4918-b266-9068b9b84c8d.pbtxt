        instruction: "export type NavigationSection = \n  | \'dashboard\'\n  | \'tutor\'\n  | \'roadmap\'\n  | \'paper\'\n  | \'focus\'\n  | \'progress\'\n  | \'notes\';\n\nexport interface QuizQuestion {\n  question: string;\n  options: string[];\n  correctIndex: number;\n  explanation: string;\n}\n\nexport interface ChatMessage {\n  id: string;\n  role: \'user\' | \'model\';\n  content: string;\n  timestamp: number;\n  suggestions?: string[];\n  quiz?: QuizQuestion[];\n  attachmentName?: string;\n  diagramSvg?: string;\n}\n\nexport interface ChatSession {\n  id: string;\n  title: string;\n  subject: string;\n  createdAt: number;\n  updatedAt: number;\n  messages: ChatMessage[];\n}\n\nexport interface RoadmapTask {\n  id: string;\n  title: string;\n  topic: string;\n  taskType: \'theory\' | \'problem-solving\' | \'revision\' | \'formula-memorization\' | \'quiz\' | string;\n  durationMinutes: number;\n  learningObjectives?: string[];\n  tutorPrompt: string;\n  completed: boolean;\n  completedAt?: number;\n}\n\nexport interface RoadmapDay {\n  dayNumber: number;\n  title: string;\n  theme: string;\n  phase: string;\n  estimatedMinutes: number;\n  tasks: RoadmapTask[];\n}\n\nexport interface StudyRoadmap {\n  id: string;\n  roadmapTitle: string;\n  subject: string;\n  summary: string;\n  totalDays: number;\n  dailyMinutes: number;\n  totalHoursEstimated: number;\n  keyMilestones: string[];\n  days: RoadmapDay[];\n  createdAt: number;\n  deadlineDate?: string;\n  knowledgeLevel?: string;\n}\n\nexport interface PaperTopic {\n  topicName: string;\n  priority: \'High\' | \'Medium\' | \'Low\';\n  difficultyTendency: \'Easy\' | \'Moderate\' | \'Hard\';\n  questionCount?: number;\n  estimatedMarksWeightage?: string;\n  priorityReason: string;\n  actionableAdvice: string;\n  keyFormulasOrConcepts?: string[];\n}\n\nexport interface PaperQuestion {\n  questionNumber: string;\n  questionSnippet: string;\n  topic: string;\n  difficulty: \'Easy\' | \'Moderate\' | \'Hard\';\n  difficultyReason: string;\n  marks?: string;\n  tutorPrompt: string;\n}\n\nexport interface PaperAnalysis {\n  id: string;\n  paperTitle: string;\n  examType: string;\n  paperSummary: string;\n  identifiedSubject: string;\n  totalQuestionsAnalyzed: number;\n  createdAt: number;\n  difficultyStats: {\n    easyPercentage: number;\n    moderatePercentage: number;\n    hardPercentage: number;\n    summary: string;\n  };\n  topics: PaperTopic[];\n  questions: PaperQuestion[];\n  strategicRevisionPlan: string[];\n}\n\nexport interface StudyNote {\n  id: string;\n  title: string;\n  subject: string;\n  tags: string[];\n  content: string;\n  isFormulaSheet?: boolean;\n  createdAt: number;\n  updatedAt: number;\n}\n\nexport interface FocusSessionLog {\n  id: string;\n  type: \'pomodoro\' | \'stopwatch\';\n  durationMinutes: number;\n  topic: string;\n  completedAt: number;\n}\n\nexport interface AssessmentRecord {\n  id: string;\n  topic: string;\n  score: number;\n  totalQuestions: number;\n  percentage: number;\n  date: number;\n}\n\nexport interface UserProgressData {\n  totalStudyMinutes: number;\n  sessionsCompleted: number;\n  streakDays: number;\n  lastStudyDate: string;\n  sessionLogs: FocusSessionLog[];\n  assessmentRecords: AssessmentRecord[];\n}\n"
