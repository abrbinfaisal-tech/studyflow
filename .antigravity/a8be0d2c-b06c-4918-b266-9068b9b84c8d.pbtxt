  view_file {
    absolute_path_uri: "file:///src/components/AITutorView.tsx"
    start_line: 174
    end_line: 274
    content: "      const resultStr = reader.result as string;\n      const base64Data = resultStr.split(\',\')[1];\n      setAttachment({\n        name: file.name,\n        mimeType: file.type || \'application/pdf\',\n        data: base64Data,\n      });\n      setErrorMsg(null);\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const sendMessage = async (customMessage?: string, requestAssessment = false) => {\n    const textToSend = customMessage !== undefined ? customMessage : inputMessage;\n    if ((!textToSend.trim() && !attachment) || loading || !currentSession) return;\n\n    setErrorMsg(null);\n    setLoading(true);\n\n    const userMsgId = \'msg-\' + Date.now();\n    const newUserMsg: ChatMessage = {\n      id: userMsgId,\n      role: \'user\',\n      content: textToSend || (attachment ? `Please examine this uploaded document: ${attachment.name}` : \'\'),\n      timestamp: Date.now(),\n      attachmentName: attachment ? attachment.name : undefined,\n    };\n\n    const updatedSessionMessages = [...currentSession.messages, newUserMsg];\n\n    // Optimistically update current session\n    const updatedCurrentSession: ChatSession = {\n      ...currentSession,\n      title: currentSession.messages.length <= 1 ? (textToSend.slice(0, 32) || \'Study Session\') : currentSession.title,\n      updatedAt: Date.now(),\n      messages: updatedSessionMessages,\n    };\n\n    const newSessionsList = sessions.map(s => s.id === currentSession.id ? updatedCurrentSession : s);\n    setSessions(newSessionsList);\n    StorageService.saveChat(updatedCurrentSession);\n\n    setInputMessage(\'\');\n    const currentAttach = attachment;\n    setAttachment(null);\n\n    try {\n      const response = await fetch(\'/api/tutor/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          messages: updatedSessionMessages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: textToSend,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment,\n          attachment: currentAttach ? { mimeType: currentAttach.mimeType, data: currentAttach.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        throw new Error(errData.error || `Server responded with status ${response.status}`);\n      }\n\n      const data = await response.json();\n\n      const aiMsg: ChatMessage = {\n        id: \'msg-ai-\' + Date.now(),\n        role: \'model\',\n        content: data.text,\n        timestamp: Date.now(),\n        suggestions: data.suggestions || [],\n        quiz: data.quiz || undefined,\n      };\n\n      const finalSession: ChatSession = {\n        ...updatedCurrentSession,\n        updatedAt: Date.now(),\n        messages: [...updatedSessionMessages, aiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n    } catch (err: any) {\n      console.error(\'Chat error:\', err);\n      setErrorMsg(err.message || \'Unable to connect to AI Tutor. Please try again.\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSaveToNotesClick = (messageContent: string) => {\n    if (onSaveToNotes) {\n      onSaveToNotes({\n        title: `${selectedSubject} Notes - ${new Date().toLocaleDateString()}`,\n        subject: selectedSubject,\n        content: messageContent,\n        tags: [selectedSubject, \'Tutor Explanation\'],\n      });\n    }"
    num_lines: 606
