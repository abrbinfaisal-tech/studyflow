        use_fast_apply: true
        replacement_chunks {
          target_content: "  const sendMessage = async (customMessage?: string, requestAssessment = false) => {\n    const textToSend = customMessage !== undefined ? customMessage : inputMessage;\n    if ((!textToSend.trim() && !attachment) || loading || !currentSession) return;\n\n    setActiveError(null);\n    setLoading(true);\n\n    const userMsgId = \'msg-\' + Date.now();\n    const newUserMsg: ChatMessage = {\n      id: userMsgId,\n      role: \'user\',\n      content: textToSend || (attachment ? `Please examine this uploaded document: ${attachment.name}` : \'\'),\n      timestamp: Date.now(),\n      attachmentName: attachment ? attachment.name : undefined,\n    };\n\n    // Preserve the student\'s question in session and storage immediately\n    const updatedSessionMessages = [...currentSession.messages, newUserMsg];\n\n    const updatedCurrentSession: ChatSession = {\n      ...currentSession,\n      title: currentSession.messages.length <= 1 ? (textToSend.slice(0, 32) || \'Study Session\') : currentSession.title,\n      updatedAt: Date.now(),\n      messages: updatedSessionMessages,\n    };\n\n    const newSessionsList = sessions.map(s => s.id === currentSession.id ? updatedCurrentSession : s);\n    setSessions(newSessionsList);\n    StorageService.saveChat(updatedCurrentSession);\n\n    setInputMessage(\'\');\n    const currentAttach = attachment;\n    setAttachment(null);\n\n    try {\n      const headers: Record<string, string> = { \'Content-Type\': \'application/json\' };\n      if (simulatedErrorMode !== \'none\') {\n        headers[\'x-simulate-error\'] = simulatedErrorMode;\n      }\n\n      const response = await fetch(\'/api/tutor/chat\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          messages: updatedSessionMessages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: textToSend,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment,\n          attachment: currentAttach ? { mimeType: currentAttach.mimeType, data: currentAttach.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        const { friendlyMsg, code } = getFriendlyErrorMessage(response.status, errData);\n\n        // Keep student question in chat, record activeError for retry\n        setActiveError({\n          message: friendlyMsg,\n          errorCode: code,\n          statusCode: response.status,\n          failedMessageId: userMsgId,\n          pendingText: textToSend,\n          pendingAttachment: currentAttach,\n          pendingAssessment: requestAssessment,\n        });\n        return;\n      }\n\n      const data = await response.json();\n\n      const aiMsg: ChatMessage = {\n        id: \'msg-ai-\' + Date.now(),\n        role: \'model\',\n        content: data.text,\n        timestamp: Date.now(),\n        suggestions: data.suggestions || [],\n        quiz: data.quiz || undefined,\n      };\n\n      const finalSession: ChatSession = {\n        ...updatedCurrentSession,\n        updatedAt: Date.now(),\n        messages: [...updatedSessionMessages, aiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n      setActiveError(null);\n    } catch (err: any) {\n      console.error(\'Chat network or fetch error:\', err);\n      setActiveError({\n        message: \'Connection to the AI service failed. Please check your network connection and try again.\',\n        errorCode: \'NETWORK_ERROR\',\n        statusCode: 502,\n        failedMessageId: userMsgId,\n        pendingText: textToSend,\n        pendingAttachment: currentAttach,\n        pendingAssessment: requestAssessment,\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  // Retry the failed response without duplicating the user question in the conversation\n  const handleRetry = async () => {\n    if (!activeError || loading || !currentSession) return;\n    const { pendingText, pendingAttachment, pendingAssessment, failedMessageId } = activeError;\n\n    setActiveError(null);\n    setLoading(true);\n\n    try {\n      const headers: Record<string, string> = { \'Content-Type\': \'application/json\' };\n      if (simulatedErrorMode !== \'none\') {\n        headers[\'x-simulate-error\'] = simulatedErrorMode;\n      }\n\n      // We send currentSession.messages without re-adding the user\'s question!\n      const response = await fetch(\'/api/tutor/chat\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          messages: currentSession.messages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: pendingText,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment: pendingAssessment,\n          attachment: pendingAttachment ? { mimeType: pendingAttachment.mimeType, data: pendingAttachment.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        const { friendlyMsg, code } = getFriendlyErrorMessage(response.status, errData);\n\n        setActiveError({\n          message: friendlyMsg,\n          errorCode: code,\n          statusCode: response.status,\n          failedMessageId,\n          pendingText,\n          pendingAttachment,\n          pendingAssessment,\n        });\n        return;\n      }\n\n      const data = await response.json();\n\n      const aiMsg: ChatMessage = {\n        id: \'msg-ai-\' + Date.now(),\n        role: \'model\',\n        content: data.text,\n        timestamp: Date.now(),\n        suggestions: data.suggestions || [],\n        quiz: data.quiz || undefined,\n      };\n\n      // Append AI response directly after the preserved user message\n      const finalSession: ChatSession = {\n        ...currentSession,\n        updatedAt: Date.now(),\n        messages: [...currentSession.messages, aiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n      setActiveError(null);\n    } catch (err: any) {\n      console.error(\'Retry network error:\', err);\n      setActiveError({\n        message: \'Connection to the AI service failed. Please check your network connection and try again.\',\n        errorCode: \'NETWORK_ERROR\',\n        statusCode: 502,\n        failedMessageId,\n        pendingText,\n        pendingAttachment,\n        pendingAssessment,\n      });\n    } finally {\n      setLoading(false);\n    }\n  };"
          replacement_content: "  const sendMessage = async (customMessage?: string, requestAssessment = false) => {\n    const textToSend = customMessage !== undefined ? customMessage : inputMessage;\n    if ((!textToSend.trim() && !attachment) || loading || !currentSession) return;\n\n    setActiveError(null);\n    setLoading(true);\n\n    const userMsgId = \'msg-\' + Date.now();\n    const newUserMsg: ChatMessage = {\n      id: userMsgId,\n      role: \'user\',\n      content: textToSend || (attachment ? `Please examine this uploaded document: ${attachment.name}` : \'\'),\n      timestamp: Date.now(),\n      attachmentName: attachment ? attachment.name : undefined,\n    };\n\n    // Preserve the student\'s question in session and storage immediately\n    const updatedSessionMessages = [...currentSession.messages, newUserMsg];\n\n    // Placeholder message for progressive streaming\n    const aiMsgId = \'msg-ai-\' + Date.now();\n    setStreamingMsgId(aiMsgId);\n    const initialAiMsg: ChatMessage = {\n      id: aiMsgId,\n      role: \'model\',\n      content: \'\',\n      timestamp: Date.now(),\n      suggestions: [],\n    };\n\n    const sessionWithPlaceholder: ChatSession = {\n      ...currentSession,\n      title: currentSession.messages.length <= 1 ? (textToSend.slice(0, 32) || \'Study Session\') : currentSession.title,\n      updatedAt: Date.now(),\n      messages: [...updatedSessionMessages, initialAiMsg],\n    };\n\n    setSessions(prev => prev.map(s => s.id === currentSession.id ? sessionWithPlaceholder : s));\n    StorageService.saveChat(sessionWithPlaceholder);\n\n    setInputMessage(\'\');\n    const currentAttach = attachment;\n    setAttachment(null);\n\n    let accumulatedText = \'\';\n    let parsedSuggestions: string[] = [];\n    let parsedQuiz: any[] | undefined = undefined;\n\n    try {\n      const headers: Record<string, string> = { \'Content-Type\': \'application/json\' };\n      if (simulatedErrorMode !== \'none\') {\n        headers[\'x-simulate-error\'] = simulatedErrorMode;\n      }\n\n      // Stream endpoint for fast, progressive response\n      const response = await fetch(\'/api/tutor/chat/stream\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          messages: updatedSessionMessages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: textToSend,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment,\n          attachment: currentAttach ? { mimeType: currentAttach.mimeType, data: currentAttach.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        const { friendlyMsg, code } = getFriendlyErrorMessage(response.status, errData);\n\n        // Remove placeholder AI message on error, keep user\'s question\n        const restoredSession: ChatSession = {\n          ...sessionWithPlaceholder,\n          messages: updatedSessionMessages,\n        };\n        setSessions(prev => prev.map(s => s.id === currentSession.id ? restoredSession : s));\n        StorageService.saveChat(restoredSession);\n\n        setActiveError({\n          message: friendlyMsg,\n          errorCode: code,\n          statusCode: response.status,\n          failedMessageId: userMsgId,\n          pendingText: textToSend,\n          pendingAttachment: currentAttach,\n          pendingAssessment: requestAssessment,\n        });\n        return;\n      }\n\n      // Read SSE stream progressively\n      const reader = response.body?.getReader();\n      const decoder = new TextDecoder(\'utf-8\');\n\n      if (!reader) throw new Error(\'ReadableStream not supported\');\n\n      let buffer = \'\';\n      while (true) {\n        const { done, value } = await reader.read();\n        if (done) break;\n\n        buffer += decoder.decode(value, { stream: true });\n        const parts = buffer.split(\'\\n\\n\');\n        buffer = parts.pop() || \'\';\n\n        for (const part of parts) {\n          const trimmed = part.trim();\n          if (!trimmed.startsWith(\'data: \')) continue;\n          const jsonStr = trimmed.replace(/^data:\\s*/, \'\');\n          try {\n            const data = JSON.parse(jsonStr);\n\n            if (data.error) {\n              throw { status: data.statusCode || 500, message: data.error, errorCode: data.errorCode };\n            }\n\n            if (data.chunk) {\n              accumulatedText += data.chunk;\n              // Clean out raw meta tags while streaming\n              const cleanPreview = accumulatedText\n                .replace(/<<<SUGGESTIONS:[\\s\\S]*?>>>/g, \'\')\n                .replace(/<<<QUIZ:[\\s\\S]*?>>>/g, \'\');\n\n              setSessions(prev => prev.map(s => {\n                if (s.id !== currentSession.id) return s;\n                return {\n                  ...s,\n                  messages: s.messages.map(m => m.id === aiMsgId ? { ...m, content: cleanPreview } : m)\n                };\n              }));\n            }\n\n            if (data.done) {\n              if (data.fullText) accumulatedText = data.fullText;\n              if (data.suggestions) parsedSuggestions = data.suggestions;\n              if (data.quiz) parsedQuiz = data.quiz;\n            }\n          } catch (parseErr: any) {\n            if (parseErr?.errorCode) throw parseErr;\n          }\n        }\n      }\n\n      const finalCleanText = accumulatedText\n        .replace(/<<<SUGGESTIONS:[\\s\\S]*?>>>/g, \'\')\n        .replace(/<<<QUIZ:[\\s\\S]*?>>>/g, \'\')\n        .trim();\n\n      const finalAiMsg: ChatMessage = {\n        id: aiMsgId,\n        role: \'model\',\n        content: finalCleanText || accumulatedText,\n        timestamp: Date.now(),\n        suggestions: parsedSuggestions,\n        quiz: parsedQuiz,\n      };\n\n      const finalSession: ChatSession = {\n        ...sessionWithPlaceholder,\n        updatedAt: Date.now(),\n        messages: [...updatedSessionMessages, finalAiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n      setActiveError(null);\n    } catch (err: any) {\n      console.error(\'Chat stream error:\', err);\n      // Clean up placeholder if empty\n      const fallbackSession: ChatSession = {\n        ...sessionWithPlaceholder,\n        messages: updatedSessionMessages,\n      };\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? fallbackSession : s));\n      StorageService.saveChat(fallbackSession);\n\n      const status = err?.status || err?.statusCode || 502;\n      const { friendlyMsg, code } = getFriendlyErrorMessage(status, err);\n\n      setActiveError({\n        message: friendlyMsg,\n        errorCode: code,\n        statusCode: status,\n        failedMessageId: userMsgId,\n        pendingText: textToSend,\n        pendingAttachment: currentAttach,\n        pendingAssessment: requestAssessment,\n      });\n    } finally {\n      setLoading(false);\n      setStreamingMsgId(null);\n    }\n  };\n\n  // Retry the failed response without duplicating the user question in the conversation\n  const handleRetry = async () => {\n    if (!activeError || loading || !currentSession) return;\n    const { pendingText, pendingAttachment, pendingAssessment, failedMessageId } = activeError;\n\n    setActiveError(null);\n    setLoading(true);\n\n    const aiMsgId = \'msg-ai-\' + Date.now();\n    setStreamingMsgId(aiMsgId);\n    const initialAiMsg: ChatMessage = {\n      id: aiMsgId,\n      role: \'model\',\n      content: \'\',\n      timestamp: Date.now(),\n      suggestions: [],\n    };\n\n    // Append streaming placeholder without re-adding the user\'s question\n    const sessionWithPlaceholder: ChatSession = {\n      ...currentSession,\n      updatedAt: Date.now(),\n      messages: [...currentSession.messages, initialAiMsg],\n    };\n\n    setSessions(prev => prev.map(s => s.id === currentSession.id ? sessionWithPlaceholder : s));\n\n    let accumulatedText = \'\';\n    let parsedSuggestions: string[] = [];\n    let parsedQuiz: any[] | undefined = undefined;\n\n    try {\n      const headers: Record<string, string> = { \'Content-Type\': \'application/json\' };\n      if (simulatedErrorMode !== \'none\') {\n        headers[\'x-simulate-error\'] = simulatedErrorMode;\n      }\n\n      const response = await fetch(\'/api/tutor/chat/stream\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          messages: currentSession.messages.map(m => ({ role: m.role, content: m.content })),\n          userMessage: pendingText,\n          gradeLevel,\n          topic: selectedSubject,\n          requestAssessment: pendingAssessment,\n          attachment: pendingAttachment ? { mimeType: pendingAttachment.mimeType, data: pendingAttachment.data } : undefined,\n        }),\n      });\n\n      if (!response.ok) {\n        const errData = await response.json().catch(() => ({}));\n        const { friendlyMsg, code } = getFriendlyErrorMessage(response.status, errData);\n\n        // Remove placeholder AI message\n        const restoredSession: ChatSession = {\n          ...currentSession,\n          messages: currentSession.messages,\n        };\n        setSessions(prev => prev.map(s => s.id === currentSession.id ? restoredSession : s));\n\n        setActiveError({\n          message: friendlyMsg,\n          errorCode: code,\n          statusCode: response.status,\n          failedMessageId,\n          pendingText,\n          pendingAttachment,\n          pendingAssessment,\n        });\n        return;\n      }\n\n      const reader = response.body?.getReader();\n      const decoder = new TextDecoder(\'utf-8\');\n      if (!reader) throw new Error(\'ReadableStream not supported\');\n\n      let buffer = \'\';\n      while (true) {\n        const { done, value } = await reader.read();\n        if (done) break;\n\n        buffer += decoder.decode(value, { stream: true });\n        const parts = buffer.split(\'\\n\\n\');\n        buffer = parts.pop() || \'\';\n\n        for (const part of parts) {\n          const trimmed = part.trim();\n          if (!trimmed.startsWith(\'data: \')) continue;\n          const jsonStr = trimmed.replace(/^data:\\s*/, \'\');\n          try {\n            const data = JSON.parse(jsonStr);\n\n            if (data.error) {\n              throw { status: data.statusCode || 500, message: data.error, errorCode: data.errorCode };\n            }\n\n            if (data.chunk) {\n              accumulatedText += data.chunk;\n              const cleanPreview = accumulatedText\n                .replace(/<<<SUGGESTIONS:[\\s\\S]*?>>>/g, \'\')\n                .replace(/<<<QUIZ:[\\s\\S]*?>>>/g, \'\');\n\n              setSessions(prev => prev.map(s => {\n                if (s.id !== currentSession.id) return s;\n                return {\n                  ...s,\n                  messages: s.messages.map(m => m.id === aiMsgId ? { ...m, content: cleanPreview } : m)\n                };\n              }));\n            }\n\n            if (data.done) {\n              if (data.fullText) accumulatedText = data.fullText;\n              if (data.suggestions) parsedSuggestions = data.suggestions;\n              if (data.quiz) parsedQuiz = data.quiz;\n            }\n          } catch (parseErr: any) {\n            if (parseErr?.errorCode) throw parseErr;\n          }\n        }\n      }\n\n      const finalCleanText = accumulatedText\n        .replace(/<<<SUGGESTIONS:[\\s\\S]*?>>>/g, \'\')\n        .replace(/<<<QUIZ:[\\s\\S]*?>>>/g, \'\')\n        .trim();\n\n      const finalAiMsg: ChatMessage = {\n        id: aiMsgId,\n        role: \'model\',\n        content: finalCleanText || accumulatedText,\n        timestamp: Date.now(),\n        suggestions: parsedSuggestions,\n        quiz: parsedQuiz,\n      };\n\n      const finalSession: ChatSession = {\n        ...currentSession,\n        updatedAt: Date.now(),\n        messages: [...currentSession.messages, finalAiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n      setActiveError(null);\n    } catch (err: any) {\n      console.error(\'Retry stream error:\', err);\n      // Remove placeholder message\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? currentSession : s));\n\n      const status = err?.status || err?.statusCode || 502;\n      const { friendlyMsg, code } = getFriendlyErrorMessage(status, err);\n\n      setActiveError({\n        message: friendlyMsg,\n        errorCode: code,\n        statusCode: status,\n        failedMessageId,\n        pendingText,\n        pendingAttachment,\n        pendingAssessment,\n      });\n    } finally {\n      setLoading(false);\n      setStreamingMsgId(null);\n    }\n  };"
