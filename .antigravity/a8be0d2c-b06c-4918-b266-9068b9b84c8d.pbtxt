              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sound.toggleAmbient(type);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Format MM:SS or HH:MM:SS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const formatTime = (totalSec: number) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const hrs = Math.floor(totalSec / 3600);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const mins = Math.floor((totalSec % 3600) / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const secs = totalSec % 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (hrs > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return `${hrs.toString().padStart(2, \'0\')}:${mins.toString().padStart(2, \'0\')}:${secs.toString().padStart(2, \'0\')}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${mins.toString().padStart(2, \'0\')}:${secs.toString().padStart(2, \'0\')}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Circular progress calculation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalSecondsInPhase = pomodoroPhase === \'focus\' ? focusDuration * 60 : breakDuration * 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const progressPercent = Math.min(100, Math.max(0, ((totalSecondsInPhase - pomodoroSecondsLeft) / totalSecondsInPhase) * 100));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
