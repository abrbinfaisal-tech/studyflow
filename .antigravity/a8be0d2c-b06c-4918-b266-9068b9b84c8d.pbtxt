              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    content: `# Cellular Respiration 4 Stages"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "1. **Glycolysis** (Cytoplasm)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Glucose (6C) -> 2 Pyruvate (3C)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Net yield: **2 ATP + 2 NADH**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Anaerobic (requires no O2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "2. **Pyruvate Decarboxylation** (Mitochondrial Matrix)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - 2 Pyruvate -> 2 Acetyl-CoA + 2 CO2 + 2 NADH"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "3. **Krebs / Citric Acid Cycle** (Mitochondrial Matrix)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Per glucose (2 turns): **2 ATP (GTP) + 6 NADH + 2 FADH2 + 4 CO2**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "4. **Oxidative Phosphorylation & Electron Transport Chain** (Inner Membrane)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Chemiosmosis driven by proton gradient across inner membrane."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Theoretical yield: ~30-32 ATP per glucose molecule."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "   - Final electron acceptor: **Oxygen (O2)**, forming H2O!`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
