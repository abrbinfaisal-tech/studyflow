        replacement_content: "    // Fast streaming with gemini-3.8-flash and ThinkingLevel.LOW to minimize latency\n    // If primary model is experiencing high demand (503), gracefully fall back to gemini-3.1-flash-lite\n    let stream;\n    let modelUsed = PRIMARY_MODEL;\n    try {\n      stream = await ai.models.generateContentStream({\n        model: PRIMARY_MODEL,\n        contents,\n        config: {\n          systemInstruction,\n          thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },\n        },\n      });\n    } catch (streamInitErr: any) {\n      const parsedInit = parseGeminiError(streamInitErr);\n      if (parsedInit.statusCode === 503 || parsedInit.errorCode === \'NETWORK_ERROR\') {\n        console.warn(`[Stream] ${PRIMARY_MODEL} busy (${parsedInit.statusCode}). Using fallback model ${FALLBACK_MODEL}...`);\n        stream = await ai.models.generateContentStream({\n          model: FALLBACK_MODEL,\n          contents,\n          config: {\n            systemInstruction,\n          },\n        });\n        modelUsed = FALLBACK_MODEL;\n      } else {\n        throw streamInitErr;\n      }\n    }\n\n    // Set headers for Server-Sent Events after successful model connection\n    res.setHeader(\'Content-Type\', \'text/event-stream\');\n    res.setHeader(\'Cache-Control\', \'no-cache, no-transform\');\n    res.setHeader(\'Connection\', \'keep-alive\');\n    res.flushHeaders?.();"
