  view_file {
    absolute_path_uri: "file:///src/components/AITutorView.tsx"
    start_line: 379
    end_line: 439
    content: "          pendingAssessment,\n        });\n        return;\n      }\n\n      const data = await response.json();\n\n      const aiMsg: ChatMessage = {\n        id: \'msg-ai-\' + Date.now(),\n        role: \'model\',\n        content: data.text,\n        timestamp: Date.now(),\n        suggestions: data.suggestions || [],\n        quiz: data.quiz || undefined,\n      };\n\n      // Append AI response directly after the preserved user message\n      const finalSession: ChatSession = {\n        ...currentSession,\n        updatedAt: Date.now(),\n        messages: [...currentSession.messages, aiMsg],\n      };\n\n      setSessions(prev => prev.map(s => s.id === currentSession.id ? finalSession : s));\n      StorageService.saveChat(finalSession);\n      setActiveError(null);\n    } catch (err: any) {\n      console.error(\'Retry network error:\', err);\n      setActiveError({\n        message: \'Connection to the AI service failed. Please check your network connection and try again.\',\n        errorCode: \'NETWORK_ERROR\',\n        statusCode: 502,\n        failedMessageId,\n        pendingText,\n        pendingAttachment,\n        pendingAssessment,\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSaveToNotesClick = (messageContent: string) => {\n    if (onSaveToNotes) {\n      onSaveToNotes({\n        title: `${selectedSubject} Notes - ${new Date().toLocaleDateString()}`,\n        subject: selectedSubject,\n        content: messageContent,\n        tags: [selectedSubject, \'Tutor Explanation\'],\n      });\n    }\n  };\n\n  return (\n    <div className=\"flex h-[calc(100vh-5rem)] max-w-7xl mx-auto gap-4\">\n      {/* Left Chat Sessions Drawer / Sidebar */}\n      <div className=\"hidden md:flex flex-col w-64 rounded-2xl bg-slate-900/70 border border-purple-500/20 backdrop-blur-md p-3.5 shadow-xl\">\n        <button\n          onClick={() => createNewChat()}\n          className=\"flex items-center justify-center gap-2 w-full py-2.5 px-3 rounded-xl bg-gradient-to-r from-purple-600 to-violet-600 hover:from-purple-500 hover:to-violet-500 text-white font-medium text-xs shadow-md shadow-purple-950/40 transition-all mb-3\"\n        >"
    num_lines: 761
    num_bytes: 31758
    line_range_bytes: 2120
  }
