      thinking_signature: "\022\304\b\n\301\b\001i\024}\023\301n\272:L\n\374+\302\350qq\364@`mj\271\322C\311\r\374\304/Mh7\256\3317 \204U\326*\023\036\v\333\217\311\257\005(8\237\271\322\254+w\222\a\200\362W\327\226?\361}m0\332\242Z\273\307\017\347\002\020C\251\244\346l\315\314\305\3744=b\304\215\320\0255wvv\350]o\246\\\344R\353c\242>\317\341\234\325\214\365/\3539\020\027\234\v7\331\356\235\203kN\231U\356\270\235\2353\317\344\335FV\317\362\300\002r\227\245\322\376c)\034\241\314Y:H\361Y<\202K_P\265\312W\204\310j@\223\272\321\205\266ti\373\017\305\306N\023\272\t\aL\235\363%\261fN?\000\210\\\325\275\024\030C\220h\3360\"\271\257\331\223\361Ub/_\326\020/\303fK\2647\376\372/\204\277\213<\\K\b\251\003P_\253\263\fm\314\331h:\345T\216\t\353U\256\263\246\211\f\2751|\236\000\221\277\344\245\340l\373\242\021 \264>\215\334@M\245\322+T\375\370\250,\371\fo\335\335j\214:3\253\253_1\023Zu#\242\364O\2055\202\317\366t\377\f\244E\310\360\367\003\342\005:x\271\237\253\220\215sagM\261\201R\324\234\273=\347\347n\317\244O9\366\252\305\017\315\340i\036+]\2079g\230P\265\003\005\2303\267\337\033U\301En\267\346\023\t\323\352b\347\246\v\272\240`V\346\363\200\315\033\030zd&g\356ai\343\371X\f\322\373\257\232$\323\227\"\234\037\237\256c\v\021\222\272\301vd{=\216\242\253SO\270{kV\325\212\3776\261HP\353z\266\367\"\251\221\'N\000\336\023\025|}M\336\346W\320&\004\213\307\005\270\"\206\273\232\226\a\326\332\242\036\232#R\224,\214\212\022v\303s\244\376\321\203@]\241\201\366*x\360X\320qBbV\005mlL\023\253\n\306\253\305\206\303\203\356\345\232S\226;\344\237\304m\r\302fAh\300\231\276\215\253\003\340]\2450\2323\342b/Z\233{\337\'\306\221AQ\257\327#\370\361s\226\006\307Pt?\207eB$\020b\374\037%g\211X\364\272\336\023\321\214WWu\036\\)C\261\207\247&\307\275]h\264\264\343\025\f\177\251\202\a\231\a\2251\346(\321\330g\373\205d\324j\337a\321(\274YM\212N\231\r\367\240\356\364\364+\210(2\266E@\224\215\345\262U]\003L.\375_B\330\214\273\377:\323>\231\b\343&\031%/:\355\'\'Q\231\336\312A\233?&m\v\270\017\034^O\025Ma\3616\251>\\AKP\311B\313!\036\022\375\207\005Y\335.a~\371\243E\'*\316\024\352\250\374\3579\352,\032F\367\262\240V:;\365\307>F\n\333\302=\230P\026!\306A\343K\273\222\273H\022\272\276\264\367w\357\027\256\002o\235+\376\2051\337o\241\374\031;\372l\360\'+\267\263r\341\364j\304Y\344\354W\222\340qW}\231\026\3765|7\020\0061\262\222M\033\257\327\037\214~d2\035B\323\270\312\022\257\265;6qe\355\355\270\340\342\222A\306G\352\210\027H\207cZ\372\332\331\370\302(\020\252P$\333\2229\364\265\265<^\371D\351\231\320U\351\267\334\310\257\004\356n\311N\306\321\3366\214\361&\363\271\253)3\302\0219\034\215\220\331B\345\310\b\202\357\342\204\242\376DH+\321\235\351^3|\330\272\200HZ\034\247\266\250\347>\373\017\275\330\355p\314\304\253\260\346P\270\234rv\240,\322-7\300>\r#\n\005\033\262\031\3401X\032\275kE\247\262\371O\277w\262U: \036\274Y[\244\303\003\0000\357\274\003\364mS\\\321\327DA\314\2574D\367@\267XwnD\311\357\227Do\264\340Wo\246\246\201C\207bk,]I\256.\373\025wo\235\224\336\030\261B\324nhla\376\232\343)\034\321\022\356N\345\352\345\251\234<\314\302+\343\343\273\037\303j\324\354\377*e\016\3460\354\255\330\316"
