      thinking_signature: "\022\323\v\n\320\v\001i\024}\023\313|\227\220\333\bq\222\320.\f\032ZS;\224\355\244\rl\026\271\000I\327\274 \242\005\367s\353\242\\\336\305\233\024\017\241C-5S\237\220\v\306d\237G\037\251\253>\336.I\266\203\356R\316\315}\262\3262\266\223\374\023\'\031\t\017\230\325\237\351/\253\021\r\336\v\244!\351A*\262\367O\027\"\243\231\373+\313\316\n\020\235\036z\316\351U\364\233B\316\263\230\245~\021l\371\343\003\232\\\0226\226\331\371\354\216\021\005i\263\355K\002\214\377\025\005\322\356\275Y\371\375\326FF\f\361\v\263\204S\266\006\004\251\363\267t\344\025\251\306Y\275\327\343\000\314C\315\224-\312\215\"\037Q\315\360d\347\3013\317\031`\227\000\320\230\247=>V\250\021*_b5\353~\225\b\030\367\204r\232U\261\367gzUn:^\006]S\262\267\203I\220\333\264}F\263*a\222\252\201\232:\267\240Xu\300\017v\212Fo1\031\263\311\241\206\212\203j\\\367\310]t\246\326-\323P#v\265\260\306R\252\325q\020\326\245|6\203\0162T\251A\252\020\250\2025>\363Q\365Q\353\000\304~\253\356\3722\t\177\344\227\260\021F\261\024\361\244\025\262\335\243W9\350~\254\306\266\200\350\365@B\265\376:\370aaK2\030\371W\230B7\003\211X\350\362\322NN{\371\317w\030\016\211\347\2640\310\271\220\274a*\225=\324\003\236d\271IrzB\035@Y\370\364\352\253x};d\265\221\332\\J\212\204a\311\213\334f\373\"\234\016\027j\036\200\177\240\207B\265\032uI\373\016|f7\033_\235\346\371\346\261J\221\240\233\211\267\3742\273a\376\r\275\251:\226N\227\006~C\360\265\231`7\355\321\000\335#\351\331\353\3574\323\316\2147\220c\371\303Qj\312e-3hR\265\n\r3\364\355\017`\204IDx8\313R\267M\033!\221\276I\337\n\351\361\345%\265vY\3728\370Z\025d\3354\245\023\250 \016\"\256z\352c)m\355ob\356\334\347\265\270\313u\324\267\245\377\232\006\375\334{!\300\2500\247\0351\027U#\367\210\351l3\255lH\2067\366\b1t/}\230\334\203TP\320\003\261\330g\223\250\204\234\342\233|N\320\304\207\246b\221\303\245i\272R\033fCA\227\323O\206\023\027D]\227\320\255t\260\005r\233y\220+\361\001\221\270kw\031\35571z|F\211\362\347.\240\317\3440\262V\304\2333\270\313\253Z\021\264*H\241<}